# .env is better suited for public variables, ie, variables that should not commited
# For secret variables is better to use DevServerControl tool with set_env_variable: ["KEY", "SECRET"]

# https://www.builder.io/c/docs/using-your-api-key
VITE_PUBLIC_BUILDER_KEY=__BUILDER_PUBLIC_KEY__
PING_MESSAGE="ping pong"

# Database URLs (get these from your Vercel Neon database)
DATABASE_URL=postgresql://username:password@your-neon-host-pooler.neon.tech/neondb
DIRECT_URL=postgresql://username:password@your-neon-host.neon.tech/neondb

# JWT Secret (generate a long random string)
JWT_SECRET=your-long-random-secret-here-replace-with-actual-secret

PAYSTACK_STARTER_CHECKOUT_URL=https://paystack.shop/pay/p2zby8um-l
PAYSTACK_GROWTH_CHECKOUT_URL=https://paystack.shop/pay/m7eea087kh
PAYSTACK_ENTERPRISE_CHECKOUT_URL=https://paystack.shop/pay/p124xzxn63
