PING_MESSAGE=ping
APP_URL=http://localhost:8080

# Runtime connection string. On Neon this can be the pooled connection.
DATABASE_URL=postgres://username:password@your-neon-host-pooler.neon.tech/neondb

# Recommended for Prisma CLI and migrations on Neon/Vercel.
# On Vercel, this should match the direct Prisma connection
# and is aliased from POSTGRES_PRISMA_URL during the Vercel build.
DIRECT_URL=postgres://username:password@your-neon-host.neon.tech/neondb
JWT_SECRET=replace-with-a-long-random-secret
DEBUG_API_REQUESTS=false

PAYSTACK_SECRET_KEY=
PAYSTACK_STARTER_PLAN_CODE=
PAYSTACK_GROWTH_PLAN_CODE=
PAYSTACK_ENTERPRISE_PLAN_CODE=
PAYSTACK_CUSTOM_PLAN_CODE=

# Optional local override when using the JSON file fallback instead of Postgres.
DIVINEDESK_DATA_DIRECTORY=
