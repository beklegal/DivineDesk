PING_MESSAGE=ping
APP_URL=http://localhost:8080

# Preferred for Neon/Vercel. The app also accepts POSTGRES_URL_NON_POOLING or POSTGRES_URL.
DATABASE_URL=postgres://username:password@your-neon-host.neon.tech/neondb

PAYSTACK_SECRET_KEY=
PAYSTACK_STARTER_PLAN_CODE=
PAYSTACK_GROWTH_PLAN_CODE=
PAYSTACK_ENTERPRISE_PLAN_CODE=
PAYSTACK_CUSTOM_PLAN_CODE=

# Optional local override when using the JSON file fallback instead of Postgres.
DIVINEDESK_DATA_DIRECTORY=
