{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "pnpm vercel-build",
  "outputDirectory": "dist/spa",
  "env": {
    "NODEJS_HELPERS": "0"
  },
  "functions": {
    "api/**/*.ts": {
      "includeFiles": "server/data/**/*.json",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
