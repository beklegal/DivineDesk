{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "DIRECT_URL=$POSTGRES_PRISMA_URL pnpm prisma:generate && DIRECT_URL=$POSTGRES_PRISMA_URL pnpm prisma:migrate && pnpm build:client",
  "outputDirectory": "dist/spa",
  "functions": {
    "api/**/*.ts": {
      "includeFiles": "server/data/**/*.json",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
